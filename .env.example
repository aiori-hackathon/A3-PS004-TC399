# Use 127.0.0.1 for testing from this PC only.
# For ESP32 access, replace this with the PC's Wi-Fi/Ethernet IPv4 address
# (find it with ipconfig), then re-run the certificate-generation command.
GATEWAY_IP=127.0.0.1

# MongoDB persistence for the dashboard (internal Docker network only; no host port published).
# Replace MONGO_PASSWORD in your local .env (never commit .env).
MONGO_USER=aegisdns
MONGO_PASSWORD=change-me-local-only
MONGO_DB=aegisdns
RETENTION_DAYS=30

# Networking mode for host-run tools (test_gateway.py, serial_to_dashboard.py, latency_baseline.py).
# HOST mode (default when running Python directly on your machine):
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8853
METRICS_URL=http://127.0.0.1:3001/api/metrics
DASHBOARD_URL=http://127.0.0.1:3001
# NETWORK mode (used automatically by the optional Compose tools/serial-linux profiles):
#   GATEWAY_HOST=gateway, GATEWAY_PORT=853, METRICS_URL=http://dashboard:3000/api/metrics

# Optional ESP32 serial bridge settings.
# Set DEVICE_ID equal to the ESP32 mTLS certificate CN (e.g. esp32-client) so DNS metrics
# and serial telemetry line up under the same device entry.
DEVICE_ID=unknown
SERIAL_PORT=COM13
SERIAL_BAUD=115200
# Linux/Raspberry Pi only (used by optional `serial-linux` Compose profile):
SERIAL_DEVICE=/dev/ttyUSB0

# APNIC Network Intelligence Layer settings
# Official APNIC data directory and update interval (hours)
APNIC_DATA_DIR=data/apnic
APNIC_DB_PATH=data/apnic/apnic.db
APNIC_UPDATE_INTERVAL_HOURS=24
APNIC_REQUEST_TIMEOUT_SECONDS=60
# Expected APNIC OpenPGP signing key fingerprint (hexadecimal, 40 characters)
# Leave empty until independently verified out-of-band by an operator.
# When configured, PGP signature verification will strictly require a matching key.
# Example: APNIC_GPG_FINGERPRINT=53484F6685D112B194DD25D9CB342F01D1524E14
APNIC_GPG_FINGERPRINT=
