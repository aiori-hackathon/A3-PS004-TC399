# ==========================================
# AegisDNS — Secrets and generated files
# ==========================================

# Environment configuration
.env
.env.*
!.env.example

# Private keys and certificate material
*.key
*.private
*.pem
*.p12
*.pfx
*.csr
*.srl

# Generated DNSSEC keys, signed zones and trust anchors
src/dns/generated/*
!src/dns/generated/.gitkeep

# Generated PKI and device credentials
src/pki/*
!src/pki/.gitkeep

src/esp32/certs/*
!src/esp32/certs/.gitkeep

# ==========================================
# Python
# ==========================================

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ==========================================
# Node.js
# ==========================================

node_modules/
npm-debug.log*  
.npm/

# ==========================================
# Operating system and editors
# ==========================================

.DS_Store
Thumbs.db
.vscode/
.idea/

# Local dashboard backups
src/dashboard/public/index.backup.html